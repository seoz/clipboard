# QuickPaste build configuration — deliberately committed.
#
# WHY THIS IS IN GIT
#
# Every value here is a PUBLIC IDENTIFIER, not a credential. Google's own
# documentation is explicit about the Firebase ones: "API keys restricted to
# Firebase services do not need to be treated as secrets, and it's safe to
# include them in your code or configuration files."
# https://firebase.google.com/docs/projects/api-keys
#
# The Firebase API key identifies the *project*; it authorises nothing on its
# own. What actually protects user data, in order:
#
#   1. Firebase Auth — a request must carry a valid Google-issued token.
#   2. Firestore Security Rules — that token's uid must match the document
#      path (see firestore.rules; every rule gates on request.auth.uid).
#   3. End-to-end encryption — the server only ever holds ciphertext, so even
#      full access to the Firebase project yields nothing readable.
#
# These values also ship inside every built extension, which is a zip anyone
# can unpack — so committing them changes nothing about their exposure, while
# making the extension buildable on a new machine with no setup at all.
#
# THE ONE THING THAT IS SECRET: quickpaste.pem, the private signing key that
# scripts/generate-key.sh writes. It is gitignored and must stay that way.
# Only its PUBLIC half (EXT_PUBLIC_KEY, below) belongs here.
#
# TO POINT AT YOUR OWN FIREBASE PROJECT: create .env.local with the same keys.
# It is gitignored and overrides everything here — no need to edit this file.

# Firebase web config.
# Firebase console -> Project settings -> General -> Your apps -> Web app -> Config
VITE_FIREBASE_API_KEY=AIzaSyAkD3YYaZKKdlxexlzbwRpXegc_gBR8mq8
VITE_FIREBASE_AUTH_DOMAIN=clipboard-8e570.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=clipboard-8e570
VITE_FIREBASE_STORAGE_BUCKET=clipboard-8e570.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=157600362400
VITE_FIREBASE_APP_ID=1:157600362400:web:c076652d9830b685793ec5

# OAuth client of type "Chrome Extension".
# Google Cloud console -> Google Auth Platform -> Clients.
# This client type issues no client secret at all, by design.
# Injected into manifest.json at build time.
OAUTH_CLIENT_ID=157600362400-a2f6pkft8dj1tbb9skpoikfhl6gk0mp1.apps.googleusercontent.com

# Base64 DER PUBLIC key. Pins the extension ID so it is identical on every
# machine, which is what lets one OAuth client work everywhere. Derived from
# quickpaste.pem — the private half, which stays out of git.
# Injected into manifest.json at build time.
EXT_PUBLIC_

# Point the build at a local emulator suite instead of the real project.
VITE_USE_FIREBASE_EMULATOR=false
VITE_EMULATOR_AUTH_URL=http://127.0.0.1:9099
VITE_EMULATOR_FIRESTORE_HOST=127.0.0.1
VITE_EMULATOR_FIRESTORE_PORT=8080

# PBKDF2 work factor for the sync passphrase.
# Safe to raise later: the value used is recorded per user in Firestore.
VITE_PBKDF2_ITERATIONS=600000
