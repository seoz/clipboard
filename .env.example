# Firebase web config.
#
# These are PUBLIC IDENTIFIERS, not secrets — see src/lib/config.js and
# DESIGN.md for why. They live in env so dev/prod/emulator are switchable
# without a code edit. Copy this file to .env.local and fill it in.
#
# Find them in: Firebase console -> Project settings -> General ->
# "Your apps" -> Web app -> SDK setup and configuration -> Config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# OAuth client of type "Chrome Extension", from
# Google Cloud console -> Google Auth Platform -> Clients.
# A public identifier; this client type issues no secret.
# Injected into manifest.json at build time.
OAUTH_CLIENT_ID=

# Base64 DER public key that pins the extension ID.
# Generate with ./scripts/generate-key.sh — the .pem it writes is the real
# secret and must never be committed. Injected into manifest.json at build time.
EXT_PUBLIC_KEY=

# Point the build at a local emulator suite instead of the real project.
VITE_USE_FIREBASE_EMULATOR=false
VITE_EMULATOR_AUTH_URL=http://127.0.0.1:9099
VITE_EMULATOR_FIRESTORE_HOST=127.0.0.1
VITE_EMULATOR_FIRESTORE_PORT=8080

# PBKDF2 work factor for the sync passphrase (Phase 2).
# Safe to raise later: the value used is recorded per user.
VITE_PBKDF2_ITERATIONS=600000
