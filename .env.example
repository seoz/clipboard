# Copy this file to .env.local to point the build at your OWN Firebase
# project instead of the one already committed in .env.
#
# You do NOT need this file for normal use — `npm run build` works out of
# the box against the checked-in .env. This is only for forking the project
# onto a different Firebase backend. .env.local is gitignored and overrides
# every value in .env.

# Firebase web config.
# Find these in: Firebase console -> Project settings -> General ->
# "Your apps" -> Web app -> SDK setup and configuration -> Config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# OAuth client of type "Chrome Extension", from
# Google Cloud console -> Google Auth Platform -> Clients.
# This client type issues no secret. Injected into manifest.json at build time.
OAUTH_CLIENT_ID=

# Base64 DER public key that pins the extension ID, from
# ./scripts/generate-key.sh — the .pem it writes is the real secret and must
# never be committed. Injected into manifest.json at build time.
EXT_PUBLIC_KEY=

# Point the build at a local emulator suite instead of a real project.
VITE_USE_FIREBASE_EMULATOR=false
VITE_EMULATOR_AUTH_URL=http://127.0.0.1:9099
VITE_EMULATOR_FIRESTORE_HOST=127.0.0.1
VITE_EMULATOR_FIRESTORE_PORT=8080

# PBKDF2 work factor for the sync passphrase.
# Safe to raise later: the value used is recorded per user in Firestore.
VITE_PBKDF2_ITERATIONS=600000
