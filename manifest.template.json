{
  "manifest_version": 3,
  "name": "QuickPaste",
  "version": "1.0",
  "description": "Store and manage multiple texts with easy clipboard access",
  "permissions": [
    "storage",
    "clipboardWrite",
    "identity",
    "alarms"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "QuickPaste",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "mac": "MacCtrl+Command+C"
      }
    }
  },
  "host_permissions": [
    "https://identitytoolkit.googleapis.com/*",
    "https://securetoken.googleapis.com/*",
    "https://firestore.googleapis.com/*",
    "https://oauth2.googleapis.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "oauth2": {
    "client_id": "__OAUTH_CLIENT_ID__",
    "scopes": [
      "openid",
      "email",
      "profile"
    ]
  },
  "key": "__EXT_PUBLIC_KEY__"
}
